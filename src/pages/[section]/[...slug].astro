---
import 'katex/dist/katex.min.css';
import { render } from 'astro:content';
import { STAGES, STATUS_LABEL, TYPE_LABEL } from '../../consts';
import Base from '../../layouts/Base.astro';
import { type Note, backlinks, getNotes, makeLinker, outgoing, sectionOf, urlOf, ymd } from '../../lib/notes';

// One route for every vault section: /sessions/…, /concepts/…, /essays/…
export async function getStaticPaths() {
	const notes = await getNotes();
	return notes.map((note) => ({
		params: { section: sectionOf(note), slug: note.id.split('/').slice(1).join('/') },
		props: { note, notes },
	}));
}

interface Props {
	note: Note;
	notes: Note[];
}

const { note, notes } = Astro.props;
const { data } = note;
const { Content, headings } = await render(note);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

const link = makeLinker(notes);
const topics = data.topics.map((name) => ({ name, note: link(name) }));
// Concept notes linked from the body but not listed in `topics`.
const mentioned = [...outgoing(note, link)].filter(
	(n) => n.data.type === 'concept' && !data.topics.some((t) => link(t)?.id === n.id),
);
const linkedFrom = backlinks(note, notes, link);
const stageName = (n: number) => STAGES.find((s) => s.n === n)?.name ?? `${n}단계`;
---

<Base title={data.title}>
	<div class="note-page">
		{
			toc.length > 0 && (
				<nav class="toc-side" aria-label="목차">
					<p class="label">목차</p>
					<ol>
						{toc.map((h) => (
							<li class={`d${h.depth}`}>
								<a href={`#${h.slug}`}>{h.text}</a>
							</li>
						))}
					</ol>
				</nav>
			)
		}

		<article>
			<header class="note-head">
				<p class="label">{TYPE_LABEL[data.type]}</p>
				<h1>{data.title}</h1>
				<p class="meta">
					<time datetime={ymd(data.date)}>{ymd(data.date)}</time>
					{data.minutes !== undefined && data.minutes > 0 && <span>{data.minutes}분 공부</span>}
					{data.status && data.status !== 'done' && <span>{STATUS_LABEL[data.status]}</span>}
					{data.original && <a href={data.original}>원문</a>}
				</p>
				{
					(topics.length > 0 || data.stage.length > 0) && (
						<div class="chips">
							{data.stage.map((n) => (
								<a class="chip" href={`/map/#stage-${n}`}>
									{n}. {stageName(n)}
								</a>
							))}
							{topics.map((t) => (t.note ? <a class="chip accent" href={urlOf(t.note)}>{t.name}</a> : <span class="chip">{t.name}</span>))}
						</div>
					)
				}
			</header>

			{
				toc.length > 0 && (
					<details class="toc-inline">
						<summary>목차</summary>
						<ol>
							{toc.map((h) => (
								<li class={`d${h.depth}`}>
									<a href={`#${h.slug}`}>{h.text}</a>
								</li>
							))}
						</ol>
					</details>
				)
			}

			<div class="prose">
				<Content />
			</div>

			<section class="related">
				<h2 class="label">이 글의 개념</h2>
				{
					topics.length === 0 && mentioned.length === 0 ? (
						<p class="muted">연결된 개념이 아직 없습니다.</p>
					) : (
						<ul>
							{topics.map((t) =>
								t.note ? (
									<li>
										<a href={urlOf(t.note)}>{t.note.data.title}</a>
									</li>
								) : (
									<li>
										{t.name} <span class="muted">· 아직 노트 없음</span>
									</li>
								),
							)}
							{mentioned.map((n) => (
								<li>
									<a href={urlOf(n)}>{n.data.title}</a> <span class="muted">· 본문 링크</span>
								</li>
							))}
						</ul>
					)
				}
				{
					linkedFrom.length > 0 && (
						<>
							<h2 class="label">이 노트를 가리키는 글</h2>
							<ul>
								{linkedFrom.map((n) => (
									<li>
										<a href={urlOf(n)}>{n.data.title}</a>
									</li>
								))}
							</ul>
						</>
					)
				}
				{
					data.original && (
						<>
							<h2 class="label">원문</h2>
							<p class="original">
								<a href={data.original}>{data.original}</a>
							</p>
						</>
					)
				}
			</section>

			<p class="back"><a href="/log/">← 학습 로그</a></p>
		</article>
	</div>
</Base>

<script>
	// Widgets are same-origin, so size each iframe to its content (no inner scrollbar, no cut-off).
	function fit(frame: HTMLIFrameElement) {
		const body = frame.contentDocument?.body;
		if (!body) return;
		const style = frame.contentWindow!.getComputedStyle(body);
		const h = body.getBoundingClientRect().height + parseFloat(style.marginTop) + parseFloat(style.marginBottom);
		if (h > 0) frame.style.height = `${Math.ceil(h) + 2}px`;
	}
	for (const frame of document.querySelectorAll<HTMLIFrameElement>('.prose iframe')) {
		let observer: ResizeObserver | undefined;
		const attach = () => {
			const doc = frame.contentDocument;
			if (!doc?.body || doc.URL === 'about:blank') return;
			observer?.disconnect();
			observer = new ResizeObserver(() => fit(frame));
			observer.observe(doc.body);
			fit(frame);
		};
		frame.addEventListener('load', attach);
		// The widget may have loaded before this script ran.
		if (frame.contentDocument?.readyState === 'complete') attach();
	}

	// Highlight the current section in the side table of contents:
	// the last heading above the top quarter of the screen.
	const tocLinks = new Map(
		[...document.querySelectorAll<HTMLAnchorElement>('.toc-side a')].map((a) => [decodeURIComponent(a.hash.slice(1)), a]),
	);
	const tocHeadings = [...document.querySelectorAll<HTMLElement>('.prose h2[id], .prose h3[id]')];
	let ticking = false;
	const highlight = () => {
		ticking = false;
		const line = window.innerHeight / 4;
		const atEnd = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
		const current = atEnd ? tocHeadings.at(-1) : tocHeadings.filter((h) => h.getBoundingClientRect().top < line).at(-1);
		tocLinks.forEach((a, id) => a.classList.toggle('active', id === current?.id));
	};
	if (tocLinks.size) {
		addEventListener('scroll', () => ticking || ((ticking = true), requestAnimationFrame(highlight)), { passive: true });
		highlight();
	}
</script>

<style>
	/* Paper-like layout: a sticky outline on the left, one centred column for text and widgets. */
	.note-page {
		max-width: var(--note);
		margin: 0 auto;
	}
	.label {
		margin: 0;
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--text-3);
	}
	.note-head {
		margin: 64px 0 40px;
		text-align: center;
	}
	.note-head .label {
		color: var(--accent);
	}
	.note-head h1 {
		font-size: 2.4rem;
		line-height: 1.25;
		letter-spacing: -0.02em;
		margin: 12px 0 16px;
	}
	.note-head .meta {
		margin: 0 0 18px;
		color: var(--text-2);
		font-size: 15px;
	}
	.note-head .meta > * + *::before {
		content: '·';
		margin: 0 8px;
		color: var(--text-3);
	}
	.note-head .chips {
		justify-content: center;
	}
	.toc-inline {
		margin: 0 0 32px;
		padding: 12px 16px;
		border: 1px solid var(--border);
		border-radius: 10px;
		font-size: 15px;
	}
	.toc-inline summary {
		cursor: pointer;
		color: var(--text-2);
	}
	ol {
		list-style: none;
		margin: 8px 0 0;
		padding: 0;
		line-height: 1.5;
	}
	ol li {
		margin: 6px 0;
	}
	ol li.d3 {
		padding-left: 14px;
		font-size: 0.93em;
	}
	ol a {
		color: var(--text-2);
		text-decoration: none;
	}
	ol a:hover,
	ol a.active {
		color: var(--accent);
	}
	.toc-side {
		display: none;
	}
	/* Laptop and wider: the outline sits beside the column and follows the scroll. */
	@media (min-width: 1120px) {
		.note-page {
			max-width: calc(var(--note) + 2 * 230px);
			display: grid;
			/* the right track only balances the outline, so it takes what is left;
			   below ~1260px the column sits a little right of centre */
			grid-template-columns: 200px minmax(0, var(--note)) minmax(0, 1fr);
			column-gap: 30px;
		}
		.toc-inline {
			display: none;
		}
		.toc-side {
			display: block;
			position: sticky;
			top: 28px;
			align-self: start;
			max-height: calc(100vh - 56px);
			overflow-y: auto;
			margin-top: 64px;
			font-size: 13.5px;
		}
		article {
			grid-column: 2;
		}
	}
	.related {
		margin-top: 72px;
		padding-top: 8px;
		border-top: 1px solid var(--border);
		font-size: 15px;
	}
	.related h2 {
		margin: 28px 0 8px;
	}
	.related ul {
		margin: 0;
		padding-left: 1.2em;
	}
	.original {
		margin: 0;
		overflow-wrap: anywhere;
	}
	.back {
		margin: 48px 0 0;
		font-size: 15px;
	}
	.back a {
		color: var(--text-2);
		text-decoration: none;
	}
	.back a:hover {
		color: var(--accent);
	}
	@media (max-width: 600px) {
		.note-head {
			margin-top: 40px;
		}
		.note-head h1 {
			font-size: 1.8rem;
		}
	}
</style>
